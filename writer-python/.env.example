# ============================================================
# 必须复制一份改名为 .env（注意前面的点），程序只读 .env，不读本文件！
#   Windows:  copy .env.example .env
# ============================================================

# PostgreSQL（与 docker-compose / backend-java 默认一致）
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=mythosforge
POSTGRES_USER=mythosforge
POSTGRES_PASSWORD=mythosforge

# ---------- 对话 LLM（OpenAI 兼容：DeepSeek / OpenAI 等）----------
OPENAI_API_KEY=your-chat-api-key
OPENAI_BASE_URL=https://api.deepseek.com
# deepseek-chat 仍兼容但建议改用：
LLM_MODEL=deepseek-v4-flash

# ---------- 向量 Embedding（云端；可与对话分流）----------
#
# 方案 A：OpenAI 官方
# EMBEDDING_API_KEY=sk-...
# EMBEDDING_OPENAI_BASE_URL=https://api.openai.com/v1
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIMENSIONS=1536
#
# 方案 B：阿里云百炼 / 千问（OpenAI 兼容 Embeddings，推荐国内）
# 控制台 API-Key；不要把 Key 提交到 Git，只写在本地 .env
# EMBEDDING_API_KEY=你的-dashscope-key
# EMBEDDING_OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 国际地域可用：https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# EMBEDDING_MODEL=text-embedding-v4
# EMBEDDING_DIMENSIONS=1024
#
# 改 EMBEDDING_DIMENSIONS / 模型后，若 Qdrant 里已有旧集合维度不一致，请换 QDRANT_COLLECTION 名或在 Qdrant 控制台删库重建。
#
# 默认按「千问 / 百炼」向量路径举例（务必只在本地 .env 填写真实 Key，勿提交仓库）：
EMBEDDING_API_KEY=your-dashscope-or-openai-embedding-key
EMBEDDING_OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSIONS=1024

# 若改用 OpenAI 向量：参照上文「方案 A」修改上述四行。
# 若对话也用 OpenAI 且与向量同 Key，可不设 EMBEDDING_*，程序会复用 OPENAI_API_KEY。

# ---------- Day 10：Qdrant ----------
QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=
QDRANT_COLLECTION=mythos_knowledge
VECTOR_SYNC_ENABLED=true

# ---------- Day 12：Neo4j Lore Graph ----------
NEO4J_ENABLED=true
LORE_GRAPH_ENABLED=true
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=mythosforge

# ---------- Day 14：RabbitMQ Worker（python worker.py）----------
# MYTHOSFORGE_JAVA_URL=http://127.0.0.1:8080
# MYTHOSFORGE_INTERNAL_TOKEN=dev-internal-token
# RABBITMQ_HOST=localhost
# RABBITMQ_USER=mythosforge
# RABBITMQ_PASSWORD=mythosforge
# RABBITMQ_QUEUE=chapter.generation.queue
