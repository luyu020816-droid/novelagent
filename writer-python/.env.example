# ============================================================
# 必须复制一份改名为 .env（注意前面的点），程序只读 .env，不读本文件！
#   Windows:  copy .env.example .env
#   不要把密钥只写在 .env.example 里，否则会一直报 OPENAI_API_KEY is not set
# ============================================================

# PostgreSQL（与 docker-compose / backend-java 默认一致）
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=mythosforge
POSTGRES_USER=mythosforge
POSTGRES_PASSWORD=mythosforge

# LLM：OpenAI 兼容 SDK（DeepSeek 等填 KEY + BASE_URL）
OPENAI_API_KEY=sk-edf5b7e9136043d18e5ef84b0926c436
OPENAI_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
